# ──────────────────────────────────────────────────────────────────────────────
# .env.example  (root Next.js workspace)
# Copy this file to .env.local and fill in your real values.
# Never commit .env or .env.local — they contain real credentials.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (public — safe to expose to the browser) ─────────────────────────
# Found in: Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Found in: Project Settings → API → anon / public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Backend API ───────────────────────────────────────────────────────────────
# URL for the Express backend.  Must match PORT set in backend/.env.
# Default value used when this variable is absent: http://localhost:4000/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api
