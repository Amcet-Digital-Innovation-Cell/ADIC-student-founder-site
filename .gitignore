# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/

# Environment files — ignore all local env files
.env
.env.local
.env.*
.env.*.local
.env.development.local
.env.test.local
.env.production.local
