!.env.example
!**/.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# IDE — ignore personal configs, but share workspace settings
.vscode/*
!.vscode/settings.json
.idea/

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts
