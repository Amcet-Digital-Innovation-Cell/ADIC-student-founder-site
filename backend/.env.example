# ──────────────────────────────────────────────────────────────────────────────
# backend/.env.example
# Copy this file to backend/.env and fill in your real values.
# Never commit the real backend/.env — it contains your Supabase service-role key.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
# Your Supabase project URL (found in: Project Settings → API → Project URL)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase service-role (admin) key — grants full DB access; NEVER expose to clients.
# Found in: Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express API listens on.  Frontend NEXT_PUBLIC_API_URL must match.
PORT=4000

# ── EDC Access Control ────────────────────────────────────────────────────────
# Comma-separated Supabase Auth user UUIDs that have EDC-admin privileges.
# These are granted exclusively server-side and cannot be self-assigned by clients.
# Example: EDC_USER_IDS=uuid-1,uuid-2,uuid-3
EDC_USER_IDS=your-edc-user-uuid-1,your-edc-user-uuid-2

# ── Database Schema ───────────────────────────────────────────────────────────
# The Supabase Postgres schema that isolates this project's tables.
# Must match the schema name used in the SQL migrations (e.g. founder_hub).
# Falls back to "public" when unset.
DB_SCHEMA=founder_hub
