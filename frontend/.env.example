# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API URL (default is http://localhost:4000/api)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ─── Backend-only variables (set in backend/.env, NOT here) ──────────────────
# DB_SCHEMA=founder_hub
# The Supabase schema this project's tables live in.
# Set this in backend/.env or your hosting platform's backend service env.
# Do NOT prefix with NEXT_PUBLIC_ — this must never be exposed to the browser.
